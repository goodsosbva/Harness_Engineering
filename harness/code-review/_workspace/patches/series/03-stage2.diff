diff --git a/api/check_verdict.py b/api/check_verdict.py
new file mode 100644
index 0000000..76fac19
--- /dev/null
+++ b/api/check_verdict.py
@@ -0,0 +1,36 @@
+"""skipped 테스트가 정책 통과로 집계되지 않는지 확인한다."""
+import json
+import re
+import shutil
+import tempfile
+import uuid
+from pathlib import Path
+
+import playwright_runner
+from results import summarize_results
+
+ROOT = playwright_runner.ROOT = Path(tempfile.mkdtemp())
+run_id, execution_id = uuid.uuid4().hex, uuid.uuid4().hex
+run = ROOT / ".local" / "runs" / run_id
+output = run / "executions" / execution_id
+output.mkdir(parents=True)
+try:
+    scenarios = [{"scenario_key": f"R@a.md:1-DENY-{n}", "expected_policy": "deny"} for n in (1, 2, 3)]
+    (run / "test-spec.json").write_text(json.dumps({"product": "p", "version": "v", "scope": "전체", "requirements": [{"requirement_key": "R@a.md:1", "scenarios": scenarios}]}), encoding="utf-8")
+    deny = {"actual_policy": "deny"}
+    case = lambda n, status: {"scenario_key": f"R@a.md:1-DENY-{n}", "requirement_key": "R@a.md:1", "expected_policy": "deny", "status": status, "observation": deny, "screenshots": [], "traces": []}
+    (output / "execution.json").write_text(json.dumps({"target_url": "http://127.0.0.1", "started_at": "", "finished_at": "", "status": "completed", "unexecuted": [], "counts": {"screenshots": 0, "capture_errors": 0},
+        "cases": [case(1, "passed"), case(2, "skipped"), case(3, "failed")]}), encoding="utf-8")
+    (output / "playwright.log").write_text("", encoding="utf-8")
+    report = summarize_results(run_id, execution_id, publish=False)
+    verdicts = {item["scenario_key"][-1]: (item["verdict"], item["classification"]) for item in report["cases"]}
+    assert verdicts == {"1": ("passed", "TN"), "2": ("unconfirmed", None), "3": ("failed", "TN")}, verdicts
+    assert report["summary"]["quadrants"]["TN"] == 2 and report["summary"]["unconfirmed"] == 1
+    assert set(report["artifacts"]) == {"execution.json", "playwright.log"}, report["artifacts"]
+finally:
+    shutil.rmtree(ROOT)
+
+listing = "  a.spec.ts:5:5 › K-ALLOW-10 제목\nTotal: 1 test in 1 file"
+assert not re.search(rf"› {re.escape('K-ALLOW-1')}(?: |$)", listing, re.M)
+assert re.search(rf"› {re.escape('K-ALLOW-10')}(?: |$)", listing, re.M)
+print("verdict ok")
