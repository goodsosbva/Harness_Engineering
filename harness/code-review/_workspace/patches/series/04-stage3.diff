diff --git a/api/check_target_host.py b/api/check_target_host.py
new file mode 100644
index 0000000..3669e65
--- /dev/null
+++ b/api/check_target_host.py
@@ -0,0 +1,22 @@
+"""대상 호스트 검사: 메타데이터 주소는 항상 차단, 내부 주소는 opt-in일 때만 허용한다."""
+import os
+
+from target_url import check_target_host
+
+
+def rejected(url: str) -> bool:
+    try:
+        check_target_host(url)
+    except ValueError:
+        return True
+    return False
+
+
+os.environ.pop("COMMON_TESTER_ALLOW_PRIVATE", None)
+assert rejected("http://169.254.169.254/latest/meta-data/")
+assert rejected("http://127.0.0.1:8765/") and rejected("http://localhost:8765/") and rejected("http://10.0.0.5/")
+assert not rejected("http://8.8.8.8/")
+os.environ["COMMON_TESTER_ALLOW_PRIVATE"] = "1"
+assert not rejected("http://127.0.0.1:8765/") and not rejected("http://192.168.1.5:8080/")
+assert rejected("http://169.254.169.254/latest/meta-data/")
+print("target host ok")
