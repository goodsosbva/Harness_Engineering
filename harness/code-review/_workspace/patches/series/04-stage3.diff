diff --git a/api/target_url.py b/api/target_url.py
index 8fb86d0..3a361ae 100644
--- a/api/target_url.py
+++ b/api/target_url.py
@@ -1,4 +1,7 @@
-"""Validate target URL syntax without connecting to the target."""
+"""Validate target URL syntax, and check the resolved host before connecting."""
+import ipaddress
+import os
+import socket
 from urllib.parse import urlsplit
 
 
@@ -16,3 +19,19 @@ def validate_target_url(value: str) -> str:
     if not valid:
         raise ValueError('테스트 주소는 호스트가 있는 HTTP 또는 HTTPS URL이어야 합니다. 주소에 계정 정보는 넣을 수 없습니다.')
     return value
+
+
+def check_target_host(value: str) -> str:
+    """링크로컬(클라우드 메타데이터 포함)은 항상, 사설망과 루프백은 COMMON_TESTER_ALLOW_PRIVATE=1일 때만 허용한다."""
+    host = urlsplit(value).hostname
+    try:
+        addresses = {info[4][0].split("%")[0] for info in socket.getaddrinfo(host, None)}
+    except (socket.gaierror, UnicodeError) as error:
+        raise ValueError(f"테스트 주소의 호스트를 찾지 못했습니다: {host}") from error
+    allow_private = os.getenv("COMMON_TESTER_ALLOW_PRIVATE") == "1"
+    for address in map(ipaddress.ip_address, addresses):
+        if address.is_link_local or address.is_multicast or address.is_unspecified or address.is_reserved:
+            raise ValueError(f"접근할 수 없는 주소입니다: {host} ({address})")
+        if (address.is_private or address.is_loopback) and not allow_private:
+            raise ValueError(f"내부 주소입니다. 로컬 앱을 검사하려면 .env에 COMMON_TESTER_ALLOW_PRIVATE=1을 설정하십시오: {host}")
+    return value
