 ROOT = Path(__file__).resolve().parents[1]
+# 생성 코드가 실행되는 하위 프로세스에는 이 목록의 환경변수만 넘긴다.
+CHILD_ENV_KEYS = (
+    "PATH", "PATHEXT", "SYSTEMROOT", "SYSTEMDRIVE", "WINDIR", "COMSPEC", "TEMP", "TMP",
+    "USERPROFILE", "HOMEDRIVE", "HOMEPATH", "LOCALAPPDATA", "APPDATA", "PROGRAMDATA",
+    "PLAYWRIGHT_BROWSERS_PATH", "NODE_EXTRA_CA_CERTS", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY",
+)
+SPEC_IMPORTS = {"@playwright/test", "../../../../playwright-observations"}
+# ponytail: 정규식 거부 목록이라 난독화로 우회 가능하다. 실제 경계는 컨테이너/저권한 계정 격리로 옮겨야 한다.
+SPEC_FORBIDDEN = re.compile(
+    r"\b(?:require|eval|Function|constructor|globalThis|child_process|fs|fetch|Buffer)\b"
+    r"""|\bimport\s*\((?!\s*['"]@playwright/test['"]\s*\))|\\u|\bprocess\b(?!\.env\.COMMON_TESTER_TARGET_URL\b)"""
+)
+
+
+def child_env(**extra: str) -> dict:
+    env = {key: os.environ[key] for key in CHILD_ENV_KEYS if key in os.environ}
+    env.update(extra)
+    return env
+
+
+def check_spec_source(name: str, content: str) -> None:
+    for module in re.findall(r"""\b(?:from|import)\s*['"]([^'"]+)['"]""", content):
+        if module not in SPEC_IMPORTS:
+            raise RuntimeError(f"허용되지 않은 import가 있습니다: {name}: {module}")
+    found = SPEC_FORBIDDEN.search(content)
+    if found:
+        raise RuntimeError(f"생성 테스트에 허용되지 않은 코드가 있습니다: {name}: {found.group(0)}")
 
 
