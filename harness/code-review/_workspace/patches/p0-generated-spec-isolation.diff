diff --git a/api/check_spec_gate.py b/api/check_spec_gate.py
new file mode 100644
--- /dev/null
+++ b/api/check_spec_gate.py
@@ -0,0 +1,25 @@
+"""Reject generated specs that reach outside the browser test API, and keep child env minimal."""
+import os
+from unittest.mock import patch
+
+from playwright_runner import check_spec_source, child_env
+
+ok = """import { test, expect } from '../../../../playwright-observations';
+const target = process.env.COMMON_TESTER_TARGET_URL || 'http://127.0.0.1:8765/';
+async function open(page: import('@playwright/test').Page) { await page.goto(target); }
+test('S1 deny', async ({ page }) => { await open(page); await expect(page.locator('#x')).toBeDisabled(); });"""
+check_spec_source('ok.spec.ts', ok)
+bad = ["import { execSync } from 'child_process';", "import fs from 'node:fs';", "process.env.OPENAI_API_KEY",
+       "require('fs')", "await import('os')", "eval('1')", "x.constructor.constructor('return 1')()",
+       "\u0072equire('fs')", "fetch('http://169.254.169.254/')", "process.exit(1)"]
+for line in bad:
+    try:
+        check_spec_source('bad.spec.ts', ok + '\n' + line)
+    except RuntimeError:
+        continue
+    raise AssertionError('passed: ' + line)
+with patch.dict(os.environ, {'OPENAI_API_KEY': 'x', 'AWS_SECRET_ACCESS_KEY': 'y', 'PATH': 'p'}):
+    env = child_env(COMMON_TESTER_TEST_DIR='d')
+assert env['PATH'] == 'p' and env['COMMON_TESTER_TEST_DIR'] == 'd'
+assert 'OPENAI_API_KEY' not in env and 'AWS_SECRET_ACCESS_KEY' not in env
+print('spec gate ok')
